# Copy to .env. Never commit .env.
K12TA_LLM_PROVIDER=anthropic
K12TA_LLM_API_KEY=
K12TA_LLM_MODEL=
K12TA_LLM_MAX_REQUESTS_PER_RUN=40
K12TA_DATA_DIR=./data
K12TA_COACH_NAME=Coach
K12TA_DAILY_TOKEN_BUDGET_USD=1.50
K12TA_LOG_LEVEL=INFO
# Gates one action in k12ta.keys: overriding a source's feedback mode. Leave unset
# to disable that action entirely -- it refuses rather than accepting a blank PIN.
K12TA_PARENT_PIN=
